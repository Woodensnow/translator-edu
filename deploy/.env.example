# Copy to deploy/.env (same directory as docker-compose.yml). Never commit deploy/.env.
#
#   openssl rand -hex 32
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# deploy/docker-compose.yml substitutes ${VAR:-default}. Leave a variable unset
# or empty to take that default. WEB_ACCESS_TOKEN is required: unset and empty
# both fail `docker compose config`. A short token or this placeholder makes
# the web container exit; `docker compose logs web` shows why.
WEB_ACCESS_TOKEN=replace-with-openssl-rand-hex-32

# Single 2-core host. Upload jobs run ASR and translate one chunk at a time.
# ${ASR_CPU_THREADS:-2}
ASR_CPU_THREADS=2
# ${ASR_OMP_NUM_THREADS:-2}
ASR_OMP_NUM_THREADS=2
# ${TRANSLATE_INTRA_THREADS:-1}
TRANSLATE_INTRA_THREADS=1
# ${TRANSLATE_INTER_THREADS:-1}
TRANSLATE_INTER_THREADS=1
# ${TRANSLATE_OMP_NUM_THREADS:-1}
TRANSLATE_OMP_NUM_THREADS=1
# One core matches the single translate thread. 640m stays above Anna's
# measured peak (~227 MiB) with room for the runtime.
# ${TRANSLATE_CPUS:-1}
TRANSLATE_CPUS=1
# ${TRANSLATE_MEM_LIMIT:-640m}
TRANSLATE_MEM_LIMIT=640m

# ${ASR_MODEL:-base.en}
ASR_MODEL=base.en
# ${ASR_MAX_AUDIO_SECONDS:-7200}
ASR_MAX_AUDIO_SECONDS=7200
# Megabytes. The web upload cap follows this when UPLOAD_MAX_BODY is unset.
# ${ASR_MAX_UPLOAD_MB:-100}
ASR_MAX_UPLOAD_MB=100
# ${UPLOAD_MAX_BODY:-}  bytes; empty uses ASR_MAX_UPLOAD_MB × 1024 × 1024
# UPLOAD_MAX_BODY=
# ${COURSE_ID:-deep-learning}
COURSE_ID=deep-learning
# ${COURSE_TITLE:-Deep Learning}
COURSE_TITLE=Deep Learning

# Finished transcripts. 0 keeps them until someone deletes them in the page.
# ${RESULT_DIR:-/data/results}
# RESULT_DIR=/data/results
# ${RESULT_RETENTION_DAYS:-7}
# RESULT_RETENTION_DAYS=7

# Only the web port is public. Leave the other two on loopback.
# ${WEB_PUBLISH:-0.0.0.0:8080}
WEB_PUBLISH=0.0.0.0:8080
# ${ASR_PUBLISH:-127.0.0.1:8001}
ASR_PUBLISH=127.0.0.1:8001
# ${TRANSLATE_PUBLISH:-127.0.0.1:8081}
TRANSLATE_PUBLISH=127.0.0.1:8081
# ${ASR_HTTP_URL:-http://asr:8001}
ASR_HTTP_URL=http://asr:8001
# ${ASR_WS_URL:-ws://asr:8001/ws/transcribe}
ASR_WS_URL=ws://asr:8001/ws/transcribe
# ${TRANSLATE_URL:-http://translate:8080}
TRANSLATE_URL=http://translate:8080
