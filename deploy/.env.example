# Public captions page. This is the only port the ECS security group should open.
WEB_PUBLISH=0.0.0.0:8080

# Loopback debug ports. Leave these on 127.0.0.1.
# On a second ECS instance, set TRANSLATE_PUBLISH to that host's private IP,
# never 0.0.0.0, and allow the port only from the web server's private IP.
ASR_PUBLISH=127.0.0.1:8001
TRANSLATE_PUBLISH=127.0.0.1:8081

# Used by the web container. Docker DNS when all three services share a network.
ASR_HTTP_URL=http://asr:8001
ASR_WS_URL=ws://asr:8001/ws/transcribe
TRANSLATE_URL=http://translate:8080

ASR_MODEL=base.en
ASR_CPU_THREADS=2
COURSE_ID=deep-learning
COURSE_TITLE=Deep Learning
